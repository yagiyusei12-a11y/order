# Copy to .env.deploy (gitignored) and adjust paths for your machine.
ORDER_VPS_HOST=133.18.141.239
ORDER_VPS_USER=ubuntu
ORDER_VPS_KEY=C:\Users\info\.ssh\harunoyukoto2.key
ORDER_VPS_PATH=~/order
ORDER_VPS_SERVICE=order-app
# 1 にすると同一 SSH セッションで daiko 専用 clone も pull・migrate・build・daiko-app 再起動（任意）
ORDER_VPS_DAIKO_DEPLOY=0
ORDER_VPS_DAIKO_PATH=~/daiko
ORDER_VPS_DAIKO_SERVICE=daiko-app

# 非常用カゴヤ VPS（本番 ORDER_VPS_HOST とは別。daiko は載せない）
ORDER_VPS_STANDBY_HOST=133.18.180.76
