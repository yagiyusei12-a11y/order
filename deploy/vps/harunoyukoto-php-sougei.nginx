# Caddy -> host.docker.internal:9083 -> PHP-FPM (sougei のみ。zaiko なし)
server {
    listen 127.0.0.1:9083;
    listen 172.17.0.1:9083;
    listen [::1]:9083;
    server_name localhost;

    root /var/www/harunoyukoto/public;
    index index.php index.html;

    location = /sougei { return 301 /sougei/; }
    location = /sougei/ { rewrite ^ /sougei/menu.php last; }

    location ~ ^/sougei/(secrets\.php|secrets\.example\.php|error_log)$ {
        deny all;
        return 404;
    }
    location ~ /\. {
        deny all;
    }

    location ~ ^/sougei/.+\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 120s;
    }

    location /sougei/ {
        try_files $uri $uri/ =404;
    }

    location / {
        return 404;
    }
}
